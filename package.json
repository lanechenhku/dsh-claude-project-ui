{
  "name": "dsh-claude-project-ui",
  "version": "0.2.0",
  "description": "Claude-style Projects + Threads for DeepSeek Harness: a project workspace UI on top of @kyf-eng/dsh-threads (shared project briefs, a cross-thread board panel, carried-over context).",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "threads",
    "knowledge",
    "board",
    "context",
    "claude-code",
    "projects",
    "dsh-threads"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Lane Chen <lanechenhku@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanechenhku/dsh-claude-project-ui.git"
  },
  "homepage": "https://github.com/lanechenhku/dsh-claude-project-ui#readme",
  "bugs": {
    "url": "https://github.com/lanechenhku/dsh-claude-project-ui/issues"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node test/harness.mjs"
  }
}
