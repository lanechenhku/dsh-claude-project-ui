{
  "name": "dsh-project-hub",
  "version": "0.1.3",
  "description": "DeepSeek Harness plugin: a project-wide knowledge base, a cross-thread board and carried-over context for dsh-threads projects.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "threads",
    "knowledge",
    "board",
    "context"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/harness.mjs"
  },
  "author": "Lane Chen <lanechenhku@gmail.com>"
}
