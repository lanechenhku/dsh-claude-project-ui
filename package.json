{
  "name": "dsh-claude-project-ui",
  "version": "0.4.3",
  "description": "Claude-style project UI for DeepSeek Harness on top of @kyf-eng/dsh-threads: a project board over threads and tasks, extra folders mounted per project with the native folder chooser, a bilingual zh/en panel with in-app settings, and thread reports rolled into tasks.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "threads",
    "knowledge",
    "board",
    "context",
    "claude-code",
    "projects",
    "dsh-threads"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Lane Chen <lanechenhku@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanechenhku/dsh-claude-project-ui.git"
  },
  "homepage": "https://github.com/lanechenhku/dsh-claude-project-ui#readme",
  "bugs": {
    "url": "https://github.com/lanechenhku/dsh-claude-project-ui/issues"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node test/harness.mjs",
    "prepublishOnly": "node test/harness.mjs && node test/spec-check.mjs"
  }
}
