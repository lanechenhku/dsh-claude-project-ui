{
  "name": "dsh-project-hub",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: a project-wide knowledge base, a cross-thread board and carried-over context for dsh-threads projects.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "threads",
    "knowledge",
    "board",
    "context"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Lane Chen <lanechenhku@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanechenhku/dsh-project-hub.git"
  },
  "homepage": "https://github.com/lanechenhku/dsh-project-hub#readme",
  "bugs": {
    "url": "https://github.com/lanechenhku/dsh-project-hub/issues"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node test/harness.mjs"
  }
}
